# Copy to .env for local dev. See app/config.py for defaults / fallbacks.

# Postgres. Local default (docker-compose.yml) needs no override.
# A managed provider (Neon, etc.) gives you "postgresql://..." — that's
# fine, app/config.py rewrites it to the psycopg3 driver automatically.
DATABASE_URL=postgresql+psycopg://bankuser:bankpass@localhost:5432/bankdb

# Redis. Local default (docker-compose.yml) needs no override.
# A managed provider (Upstash, etc.) gives you "rediss://..." (TLS) — works as-is.
REDIS_URL=redis://localhost:6379/0

# Required in any deployed environment — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The fallback in app/config.py is for local dev only; never rely on it
# once this is reachable from outside your machine.
JWT_SECRET=dev-secret-change-in-production

# groq.com API key. /chat won't work without one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# The deployed frontend's origin, for CORS. Local CRA dev server needs no override.
FRONTEND_URL=http://localhost:3000
